# Copy to .env, replace YOUR_* values, then export it as described in docs/setup.md.
# This application does not automatically load .env.
G8_PG_HOST=YOUR_POSTGRES_HOST
G8_PG_USER=YOUR_MANAGED_IDENTITY_NAME
G8_PG_DB=YOUR_DATABASE_NAME
G8_PG_CA=/etc/ssl/certs/ca-certificates.crt
G8_BLOB_ACCOUNT=YOUR_STORAGE_ACCOUNT_URL
G8_BLOB_CONTAINER=YOUR_BLOB_CONTAINER
G8_VAULT_URL=YOUR_KEY_VAULT_URL
G8_ANCHOR_SECRET=YOUR_ANCHOR_SECRET_NAME
G8_ANCHOR_ENFORCE=strict
G8_BOOTSTRAP_ANCHOR=0
G8_DEMO=0
